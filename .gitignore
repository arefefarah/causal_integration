# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# NOTE: poetry.lock is deliberately NOT ignored. Committing it is what pins the
# exact versions every result was produced with -- omit it and "it worked last
# year" becomes unverifiable. Only libraries leave it out.

# Test / coverage / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Generated artefacts -- keep the folders, ignore their contents
data/*
!data/.gitkeep
results/*
!results/.gitkeep
outputs/
checkpoints/
*.pth
*.ckpt

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
